# Per-game generated/derived state -- regenerated by bridge/decomp_bridge.py,
# and in the case of seeds.baseline.txt, derived from data we don't have
# redistribution rights to bundle (see CREDITS.md).
games/*/seeds.baseline.txt
games/*/*.state

# postman.py output -- generated .c files derived from CLI args, same
# category as symbols.toml/seeds: regenerated on demand, not committed.
generated/

# Build/run logs
build/*.log

# play.ps1's --force-interior @file (regenerated from $ForceInterior every launch)
build/force-interior*.txt

__pycache__/
*.pyc

# Isolated live-timing session: copies of the game executable, saves, recompiler cache and
# multi-hundred-MB runtime dumps. Never commit (redistribution, size).
findings/live-timing-session/

# Raw extracts of game data (decoded from the user's disc / save states): kept locally, never published
findings/data/pe-enemy-actions-*.json
findings/data/pe-bestiary-extract-*.json
findings/data/pe-bestiary-draft-*.json
findings/data/pe-aya-level-stats-*.json
findings/data/pe-aya-hit-spheres-*.json
findings/data/pe-weapons-game-*.csv
findings/data/pe-animation-extract-*.json
findings/data/pe-beam-scheduling-extract-*.json
findings/data/pe-model-catalog-*.json
findings/data/pe-enemy-model-catalog-*.json
