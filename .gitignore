# Per-game generated/derived state -- regenerated by bridge/decomp_bridge.py,
# and in the case of seeds.baseline.txt, derived from data we don't have
# redistribution rights to bundle (see CREDITS.md).
games/*/seeds.baseline.txt
games/*/*.state

# postman.py output -- generated .c files derived from CLI args, same
# category as symbols.toml/seeds: regenerated on demand, not committed.
generated/

# Build/run logs
build/*.log

# play.ps1's --force-interior @file (regenerated from $ForceInterior every launch)
build/force-interior*.txt

__pycache__/
*.pyc
