+def _debug_quit(pid: int, port: int, *, exit_timeout: int = 15) -> bool:
+    """Ask the runtime's debug server for a clean `exit(0)` instead of a hard
+    kill, so LLVM's atexit-registered profile writer actually runs (a
+    TerminateProcess -- which is all os.kill()/_soft_stop() can do on
+    Windows -- never reaches it, and PGO training silently produces empty
+    .profraw files). Requires the training build to have PSX_DEBUG_TOOLS=ON
+    (cmd_rebuild's PGO "generate" configure sets this).
+
+    Returns True if the process is confirmed gone afterward, so callers can
+    fall back to _soft_stop when the debug server isn't reachable (older
+    builds, or PSX_DEBUG_TOOLS off).
+    """
+    try:
+        with socket.create_connection(("127.0.0.1", port), timeout=5) as sock:
+            sock.sendall(b'{"id":1,"cmd":"quit"}\n')
+            try:
+                sock.settimeout(2)
+                sock.recv(256)
+            except OSError:
+                pass  # the process may exit before it gets a reply out; fine
+    except OSError:
+        return False
+    for _ in range(exit_timeout):
+        try:
+            os.kill(pid, 0)
+        except (ProcessLookupError, PermissionError):
+            return True
+        time.sleep(1)
+    return False
+
